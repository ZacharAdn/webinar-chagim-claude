# Optional: the rules console and the LLM learner. Without it the loop
# still runs, on the deterministic rule learner.
# GROQ_API_KEY = "gsk_..."

# Optional: the ?k= key that unlocks publishing new rules. Leave it out
# and it is derived from SUPABASE_KEY (see src/access.py).
# EDITOR_KEY = "a long random string"

[connections.supabase]
SUPABASE_URL = "https://<ref>.supabase.co"
SUPABASE_KEY = "sb_publishable_..."   # publishable key only
